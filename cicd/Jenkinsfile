pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '1.0',
            description: 'Docker image tag to build and push'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Project') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la docker/hello-api'
                sh 'ls -la docker/bye-api'
            }
        }

        stage('Show Build Information') {
            steps {
                echo "Jenkins Build Number: ${BUILD_NUMBER}"
                echo "Docker Image Tag: ${IMAGE_TAG}"
                echo "Hello Image: vsdpsingh/hello-api:${IMAGE_TAG}"
                echo "Bye Image: vsdpsingh/bye-api:${IMAGE_TAG}"
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build \
                        -t vsdpsingh/hello-api:${IMAGE_TAG} \
                        docker/hello-api

                    docker build \
                        -t vsdpsingh/bye-api:${IMAGE_TAG} \
                        docker/bye-api
                '''
            }
        }

        stage('Docker Hub Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                sh '''
                    docker push vsdpsingh/hello-api:${IMAGE_TAG}
                    docker push vsdpsingh/bye-api:${IMAGE_TAG}
                '''
            }
        }

        stage('Docker Logout') {
            steps {
                sh 'docker logout'
            }
        }
    }

    post {
        success {
            echo "CI pipeline completed successfully."
            echo "Hello API: vsdpsingh/hello-api:${IMAGE_TAG}"
            echo "Bye API:   vsdpsingh/bye-api:${IMAGE_TAG}"
        }

        failure {
            echo "CI pipeline failed."
        }
    }
}

